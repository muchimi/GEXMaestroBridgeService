<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <Version>0.1.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <HidMaestroDll Condition="'$(HidMaestroDll)' == ''">$(MSBuildThisFileDirectory)..\..\lib\HIDMaestro.Core.dll</HidMaestroDll>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>gex.ico</ApplicationIcon>
    <Title>GEX Maestro Bridge Service</Title>
    <Copyright>(C) 2026 EMCS</Copyright>
    <PackageProjectUrl>https://github.com/muchimi/GEXMaestroBridgeService</PackageProjectUrl>
    <PackageIcon>gex.ico</PackageIcon>
    <RepositoryUrl>https://github.com/muchimi/GEXMaestroBridgeService</RepositoryUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="gex.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="gex.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(MockOnly)' != 'true'">
    <Reference Include="HIDMaestro.Core"><HintPath>$(HidMaestroDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(MockOnly)' == 'true'"><DefineConstants>$(DefineConstants);MOCK_ONLY</DefineConstants></PropertyGroup>
  <PropertyGroup>
    <BuildInstaller Condition="'$(BuildInstaller)' == ''">false</BuildInstaller>
    <PublishGitHubRelease Condition="'$(PublishGitHubRelease)' == ''">false</PublishGitHubRelease>
    <BridgeBuildOutput>$(MSBuildProjectDirectory)\..\..\artifacts\build\$(Configuration)\$(Platform)\</BridgeBuildOutput>
    <Description>GEX Bridge Service for HID Maestro</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(MockOnly)' == 'true'"><Compile Remove="HidMaestroBackend.cs" /></ItemGroup>
  <Target Name="CheckHidMaestro" BeforeTargets="ResolveReferences" Condition="'$(MockOnly)' != 'true' and !Exists('$(HidMaestroDll)')">
    <Error Text="Copy the HIDMaestro 2.x HIDMaestro.Core.dll into lib, or set -p:HidMaestroDll=FULL_PATH. For protocol testing only use -p:MockOnly=true." />
  </Target>
  <Target Name="CopyBridgeBuildOutput" AfterTargets="Build" Condition="'$(SkipBridgeBuildOutput)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_BridgeBuildFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BridgeBuildFiles)" DestinationFiles="@(_BridgeBuildFiles->'$(BridgeBuildOutput)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BuildBridgeInstaller" AfterTargets="Build" DependsOnTargets="CopyBridgeBuildOutput" Condition="('$(BuildInstaller)' == 'true' or '$(PublishGitHubRelease)' == 'true') and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(OS)' != 'Windows_NT'" Text="The bridge installer requires Windows and Inno Setup 6 or 7." />
    <Error Condition="'$(Configuration)' != 'Release' or '$(MockOnly)' == 'true'" Text="Installer packaging requires a real Release build (MockOnly=false)." />
    <PropertyGroup>
      <_PublishReleaseArgument Condition="'$(PublishGitHubRelease)' == 'true'">-PublishRelease</_PublishReleaseArgument>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\installer\build-installer.ps1&quot; -BridgeProject &quot;$(MSBuildProjectFullPath)&quot; -Version &quot;$(Version)&quot; -HidMaestroDll &quot;$(HidMaestroDll)&quot; -Iscc &quot;$(InnoSetupCompiler)&quot; $(_PublishReleaseArgument)" />
  </Target>
</Project>
